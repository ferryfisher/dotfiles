[branch]
    sort = -committerdate
[color]
    ui = auto
[commit]
    gpgSign = true
    verbose = true
[core]
    abbrev = 12
    autocrlf = input
    excludesFile = ~/.gitignore_global
    safecrlf = true
[diff]
    algorithm = histogram
    colorMoved = zebra
    context = 10
    renames = true
    tool = nvimdiff
    wordDiff = true
    wsErrorHighlight = all
[fetch]
    prune = true
    pruneTags = true
[github]
    user = ferryfisher
[init]
    defaultBranch = main
[log]
    date = iso
[merge]
    conflictStyle = zdiff3
[pull]
    ff = only
[rebase]
    autoSquash = true
    autoStash = true
[rerere]
    autoUpdate = true
    enabled = true
[status]
    submoduleSummary = true
[tag]
    gpgSign = true
[url "git@codeberg.org:"]
    pushInsteadOf = https://codeberg.org/
[url "git@github.com:"]
    pushInsteadOf = https://github.com/
[url "git@gitlab.com:"]
    pushInsteadOf = https://gitlab.com/
[user]
    name =  Ferry
    email = 217118383+ferryfisher@users.noreply.github.com
    signingKey = 99E289A14A9C264C
